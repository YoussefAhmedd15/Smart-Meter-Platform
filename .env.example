# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Required. PostgreSQL only — the app fails to start if this is unset or isn't
# a postgresql:// URL. Point this at your shared PostgreSQL instance, e.g.:
#   postgresql://team_member:password@your-host:5432/scdc_intelligence
# For a free cloud-hosted DB the whole team can share, use neon.tech.
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/smart_meter_db
APP_MODE=demo

# --- Auth token signing ---
# Required. Signs JWT access tokens (backend/app/core/security.py). The app
# refuses to start if this is unset, or still equals the old hardcoded
# default it used to silently fall back to. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Meter communication (see meter/config.py for full list) ---
METER_SERIAL_PORT=COM6
METER_INTERFACE=HDLC_WITH_MODE_E

# --- Data-engineering pipeline scripts (load_*.py, create_*_analytics.py,
# normalize_scdc.py, users.py, etc. — the ~17 root-level scripts) ---
# These connect directly via psycopg2, separately from DATABASE_URL above.
# PIPELINE_DB_PASSWORD is required; the scripts raise a clear error and won't
# run without it. The rest default to the pipeline's existing local settings.
PIPELINE_DB_HOST=localhost
PIPELINE_DB_PORT=5432
PIPELINE_DB_NAME=scdc_intelligence
PIPELINE_DB_USER=postgres
PIPELINE_DB_PASSWORD=your-local-postgres-password

# --- Azure DevOps Test Plans integration ---
# All four must be set for automatic sync; otherwise test cases are created
# locally only and marked azure_sync_status=NOT_CONFIGURED.
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_API_VERSION=7.1
AZURE_DEVOPS_TEST_PLAN_ID=123

# --- Azure DevOps test-run/result reporting (scripts/azure_client.py) ---
# Used only by an external pytest run that reports execution results back to
# Azure Test Plans (creates a Test Run, publishes PASS/FAIL, files Bugs on
# failure). Not called by the FastAPI app. All optional.
AZURE_DEVOPS_TEST_SUITE_ID=
# Comma-separated suite ids to search for test points when a run isn't given
# an explicit suite list. Leave empty to require suite_ids be passed in.
AZURE_DEVOPS_DEFAULT_SUITE_IDS=
# "Display Name <email>" assigned to auto-filed bugs. Leave empty to leave
# bugs unassigned rather than hardcoding a specific person.
AZURE_DEVOPS_BUG_ASSIGNEE=
